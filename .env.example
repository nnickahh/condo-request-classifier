# TypeSafe AI (Jev System One API)
# Get an API key from https://typesafe.ai to use the live Jev cloud backend.
# Leave blank to use the Offline Jev Simulator (works out-of-the-box with no key).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Optional Local Ollama Backend
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Triage Policy Thresholds
JEV_CONFIDENCE_THRESHOLD=0.55
JEV_NOUL_REVIEW_THRESHOLD=0.50

# Telegram Management Agent Bot
# Get a Bot token from Telegram's @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRstuVWXyz)
TELEGRAM_BOT_TOKEN=
# Optional Telegram Group/Channel ID for internal estate team dispatch alerts (e.g. -1001234567890)
TELEGRAM_STAFF_CHAT_ID=

# Work Order System (CMMS) & External Integration Webhooks
# REST API Port (default: 8000)
WORK_ORDER_API_HOST=0.0.0.0
WORK_ORDER_API_PORT=8000
# Optional external webhook to push work orders to Jira / ServiceNow / Slack / Zapier / CMMS
WORK_ORDER_WEBHOOK_URL=
WORK_ORDER_WEBHOOK_SECRET=
